# Required API Keys
OPENAI_API_KEY="your_openai_api_key_here"
PINECONE_API_KEY="your_pinecone_api_key_here"

# Optional Port for the Flask Server (defaults to 5000 if not set)
PORT="5000"

# Optional System Prompt (the agent has a default if this is not set)
# This specific system prompt is loaded by the agent for its general guidance.
# Other more specific prompts for refining, clarifying, and finalizing are hardcoded within the agent.
SYSTEM_PROMPT="You are an expert prompt engineer. Your task is to refine and optimize user prompts..."
